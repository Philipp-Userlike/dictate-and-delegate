    <string name="t_ddca8a00" formatted="false">szef sztabu</string>
    <string name="t_de8e5494" formatted="false">Dotknij mikrofonu, aby nagrać</string>
    <string name="t_def9cb9f" formatted="false">Rozpocznij</string>
    <string name="t_df336a1d" formatted="false">Link do wątku lub ID (thr_…)</string>
    <string name="t_dff4964d" formatted="false">Twoje środki na OpenRouter wyczerpały się. Doładuj konto na openrouter.ai i spróbuj ponownie.</string>
    <string name="t_e17493b2" formatted="false">brak odpowiedzi pod tym adresem</string>
