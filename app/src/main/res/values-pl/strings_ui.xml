    <string name="t_e2774654" formatted="false">Otwórz w ntfy</string>
    <string name="t_e281d2a6" formatted="false">Odpowiedź logowania nadeszła z nieoczekiwanego serwera (%1$s).</string>
    <string name="t_e3d95fe1" formatted="false">Gdzie otwierają się linki do wątków, zwykle https://&lt;identyfikator&gt;.getbb.app.</string>
    <string name="t_e3e3bdf6" formatted="false">Brak tekstu</string>
    <string name="t_e3ee070f" formatted="false">Nie udało się odczytać tego pliku.</string>
