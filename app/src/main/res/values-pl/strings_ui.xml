    <string name="t_b942a462" formatted="false">brak szczegółów</string>
    <string name="t_b9c5766f" formatted="false">Talk Router używa tego klucza do łączenia się z modelami mowy i tekstu przez OpenRouter.</string>
    <string name="t_bbef8fd1" formatted="false">Dodaj kafelek szybkich ustawień</string>
    <string name="t_bc1b2887" formatted="false">Serwer ntfy odpowiedział kodem HTTP %1$d.</string>
